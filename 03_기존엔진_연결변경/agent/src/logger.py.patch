+def publish_runtime_summaries():
+    try:
+        runtime,daily=log_store.runtime_summaries(C.RUNS)
+        import record_store
+        latest={};errors=[];inventory=0;count=0
+        for row in record_store.iter_records(C.ontology_root()/'runtime_operations',errors=errors):
+            count+=1;inventory^=int(objects.fingerprint(row)[0],16)
+            key=row['kind'];order=(row['started_at'],bool(row.get('finished_at')))
+            if key not in latest or order>(latest[key]['started_at'],bool(latest[key].get('finished_at'))):latest[key]=row
+        runtime['operations']=latest
+        runtime['operation_watermark']={'records':count,'sha256':f'{inventory:064x}','complete':not errors}
+        if errors:runtime.update(complete=False,operation_errors=errors[:20])
+        objects.publish_json(Path(C.WORK)/'runtime_summary.json',runtime,replace=True)
+        objects.publish_json(Path(C.WORK)/'daily_summary.json',daily,replace=True)
+    except Exception as exc:
+        # An unavailable summary is explicit; never claim an empty complete day.
+        for name in ('runtime_summary.json','daily_summary.json'):
+            objects.publish_json(Path(C.WORK)/name,
+                {'schema_version':2,'complete':False,'status':'recording_error','error':str(exc)},replace=True)
