+def ontology_root():
+    """The explicit generation pointer never relocates mutable trading ledgers."""
+    from pathlib import Path
+    pointer=Path(WORK)/'storage_generation.json'
+    if not pointer.exists():return Path(WORK)/'ontology'
+    with pointer.open(encoding='utf-8') as stream:state=json.load(stream)
+    if state.get('version')==1:return Path(WORK)/'ontology'
+    if state.get('version')!=2:raise ValueError('UNSUPPORTED_STORAGE_VERSION')
+    generation=Path(state['path'])
+    if not generation.is_absolute() or generation.is_symlink():raise ValueError('INVALID_STORAGE_GENERATION')
+    return generation/'ontology'
+
+
+def storage_input_path(path, writing=False):
+    from pathlib import Path
+    generation=ontology_root().parent
+    selected=generation/Path(path).name
+    return str(selected if writing or selected.exists() else path)
+
