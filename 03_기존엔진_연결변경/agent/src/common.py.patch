+def _journal_totals(rows,date):
+    """Pure source-bundled reducer, also executable by the frozen engine."""
+    cached=getattr(rows,'_journal_summary',None)
+    if cached is not None and cached[0]==date:return cached[1]
+    result={'fills':0,'sold':set(),'buys':{},'latest_regime':None,'invalid':False}
+    for row in rows:
+        if not isinstance(row,dict) or 'kind' not in row:
+            result['invalid']=True;continue
+        kind=row['kind'];when=row.get('time')
+        if kind in ('fill','regime') and not isinstance(when,str):result['invalid']=True
+        if kind=='fill':
+            result['fills']+=1
+            if isinstance(when,str) and when.startswith(date):
+                if row.get('side')=='매도':result['sold'].add(row.get('code'))
+                elif row.get('side')=='매수':result['buys'][row.get('code')]=result['buys'].get(row.get('code'),0)+1
+        elif kind=='regime' and isinstance(when,str) and when.startswith(date):result['latest_regime']=row
+    return result
